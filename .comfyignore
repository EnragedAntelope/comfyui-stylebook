# Exclude development-only files from the published registry archive.
# .comfyignore layers on top of .gitignore, so anything already
# gitignored is excluded automatically. This drops files we keep in git
# but do not want inside the registry package.

tests/
scripts/
examples/
user_styles.example.json
package.json
package-lock.json
node_modules/

# docs/ is NOT excluded wholesale: docs/images is what the README links
# to. docs/worklog is gitignored, so it never reaches the package anyway.
#
# docs/gallery IS excluded. It is the public web gallery, generated for
# GitHub Pages, and it is nearly 400 KB of duplicated style text that a
# ComfyUI install has no use for -- the in-app picker reads the same data
# from js/stylebook_data.js.
docs/gallery/

# js/previews/ is deliberately NOT excluded. Those atlases are what the
# style gallery draws its thumbnails from, so a registry install without
# them would open an empty gallery. They total about 4 MB and keep the
# pack working fully offline, with no download on first use.
